{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Management": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Swiss.FCh.Utils.Logging.SerilogFormatter, Swiss.FCh.Utils"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": false
  },
  "LindasExport": {
    "Enabled": true,
    "ExportTime": "02:00:00",
    "MaximumAttempts": 5,
    "RetryBaseDelayMinutes": 1,
    "MinimumChunkDelayMs": 500,
    "MaximumChunkDelayMs": 1000
  },
  "TermdatGraph": {
    "ChunkSize": 1000
  }
}
