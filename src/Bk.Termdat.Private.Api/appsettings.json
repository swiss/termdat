{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Management": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Bk.Utils.Logging.SerilogFormatter, Bk.Utils"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Migration": {
    "IsAutoMigration": "false"
  },
  "SearchApi": {
    "UrnSearch": "search",
    "UrnRecommend": "recommend"
  },
  "SearchQueue": {
    "PublishTimeoutInSeconds": 30
  },
  "Private": {
    "AchOfficeId": 1,
    "ConceptUriFormat": "https://register.ld.admin.ch/termdat/{0}"
  },
  "EntryNotePattern": {
    "StartingPattern": "USG:",
    "ObsoletePattern": "veraltet|désuet|disusato|antiquà|obsolete",
    "RarePattern": "selten|rare|raro|rar|rare",
    "ShouldAvoidPattern": "zu vermeiden|à éviter|da evitare|d'evitar|to avoid"
  },
  "DocumentService": {
    "RequestTimeoutMs": 60000
  },
  "TermdatClient": {
    "EntryDetailPath": "/search/entry/{0}",
    "EntryIdSearchQueryParameter": "s=EntryId:{0}"
  },
  "Swagger": {
    "Enabled": false
  },
  "Feedback": {
    "Email": "BK_DevOPS@bit.admin.ch"
  },
  "FileImport": {
    "Email": "terminologie@bk.admin.ch"
  },
  "EntryUnlock": {
    "IntervalInSeconds": 60
  },
  "StatisticDelete": {
    "IntervalInSeconds": 43200
  },
  "Frontend": {
    "IsProduction": true,
    "DefaultOfficeId": 1,
    "DefaultCollectionId": 123
  }
}
