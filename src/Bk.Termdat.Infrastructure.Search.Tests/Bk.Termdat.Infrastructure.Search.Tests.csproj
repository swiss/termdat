        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bk.Termdat.Infrastructure.Search\Bk.Termdat.Infrastructure.Search.csproj" />
