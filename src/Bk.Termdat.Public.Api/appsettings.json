{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Management": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Bk.Utils.Logging.SerilogFormatter, Bk.Utils"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "SearchApi": {
    "UrnSearch": "search",
    "UrnRecommend": "recommend"
  },
  "PublicApi": {
    "DefaultOfficeIds": [ 1 ],
    "DefaultVariaClassification": "VARI",
    "MaximumEntryIds": 1000
  },
  "TermdatClient": {
    "EntryDetailPath": "/search/entry/{0}",
    "EntryIdSearchQueryParameter": "s=EntryId:{0}"
  }
}
