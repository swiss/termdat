          <ntig id="tid-29">
            <termGrp>
              <term>Corona</term>
              <termNote type='termType'>synonym</termNote>
              <termNote type='usageNote'>USG: übliche Kurzform, eher umgangssprachlich und
                journalistisch; häufig in Wortverbindungen wie &quot;Corona-Situation&quot;,
                &quot;Corona-Krise&quot;, &quot;Corona-Pandemie&quot;,
                &quot;Corona-Massnahmen&quot;, &quot;Corona-Fälle&quot;,
                &quot;Corona-Infizierte&quot; oder &quot;Corona-Patienten&quot;; EXP: bezeichnet oft
                auch die von SARS-CoV-2 verursachte Krankheit (COVID-2019), die 2020 entstandene
                Pandemie oder die damit verbundene Krisensituation</termNote>
              <termNote type='usageNoteSource'>BK, Sektion Terminologie, 2020</termNote>
              <termNote type='GUID'>{92E01EAE-59CD-4452-8F5A-1A9B45C6B034}</termNote>
            </termGrp>
