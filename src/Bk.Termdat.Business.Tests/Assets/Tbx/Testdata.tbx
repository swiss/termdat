            </transacGrp>
            <transacGrp>
              <transac type="transactionType">modification</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-19T12:39:09Z</date>
            </transacGrp>
            <admin type='entrySource'>WHO, &quot;Appellation de la maladie à coronavirus 2019
              (COVID-19) et du virus qui la cause, 2020-04
              (\h!https://www.who.int/fr/emergencies/diseases/novel-coronavirus-2019/technical-guidance/naming-the-coronavirus-disease-(covid-2019!Internet,
              2020-05-07\s)</admin>
