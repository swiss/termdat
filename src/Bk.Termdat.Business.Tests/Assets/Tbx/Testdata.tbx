          <ntig id="tid-33">
            <termGrp>
              <term>nouveau coronavirus 2019</term>
              <termNote type='termType'>negative term</termNote>
              <termNote type='usageNote'>USG: à éviter; EXP: terme et abréviation utilisés au début
