        <transacGrp>
          <transac type="transactionType">modification</transac>
          <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
          <date>2024-02-19T12:50:06Z</date>
        </transacGrp>

        <langSet xml:lang="fr-ch">
          <ntig id="tid-31">
            <termGrp>
              <term>SRAS-CoV-2</term>
              <termNote type='termType'>fullForm</termNote>
              <termNote type='usageNote'>EXP: le SRAS-CoV-2 est le virus responsable de la COVID-19;
                bien que le terme anglais SARS-CoV-2 (de severe acute respiratory syndrome
                coronavirus 2) soit la désignation officielle retenue en février 2020 par le Comité
                international de taxonomie des virus, cette désignation a été partiellement
                francisée en SRAS-CoV-2 par l&apos;Organisation mondiale de la santé afin de
                concorder avec le sigle déjà retenu, en français, pour désigner le syndrome
                respiratoire aigu sévère (SRAS)</termNote>
              <termNote type='usageNoteSource'>d&apos;après Le grand dictionnaire terminologique,
                &quot;SRAS-CoV-2&quot;
                (\h!http://www.granddictionnaire.com/ficheOqlf.aspx?Id_Fiche=26557605!Internet,
                2020-03-20\s)</termNote>
              <termNote type='GUID'>{DEADB59C-A32E-4639-822D-F07759B1F7CD}</termNote>
            </termGrp>
            <transacGrp>
              <transac type="transactionType">origination</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-19T12:39:09Z</date>
            </transacGrp>
            <transacGrp>
              <transac type="transactionType">modification</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-19T12:50:06Z</date>
            </transacGrp>
            <admin type='entrySource'>Le grand dictionnaire terminologique, &quot;SRAS-CoV-2&quot;
              (\h!http://www.granddictionnaire.com/ficheOqlf.aspx?Id_Fiche=26557605!Internet,
              2020-03-20\s)</admin>
            <descripGrp>
              <descrip type='definition'>Coronavirus potentiellement mortel pour les personnes
                vulnérables, qui s&apos;est déclaré à Wuhan en 2019, transmis entre humains par
                l&apos;inhalation de gouttelettes infectieuses ou par contact avec une surface
                contaminée, et qui entraîne de la toux et des difficultés respiratoires accompagnées
                de fièvre.</descrip>
              <descripNote type='definitionType'>Le grand dictionnaire terminologique,
                &quot;SRAS-CoV-2&quot;
                (\h!http://www.granddictionnaire.com/ficheOqlf.aspx?Id_Fiche=26557605!Internet,
                2020-03-20\s)</descripNote>
            </descripGrp>
          </ntig>

          <ntig id="tid-32">
            <termGrp>
              <term>coronavirus 2 du syndrome respiratoire aigu sévère</term>
              <termNote type='termType'>synonym</termNote>
              <termNote type='GUID'>{07D36F4D-7DEC-4D9E-9595-75D0986523B3}</termNote>
