      <termEntry id='eid-2'>
        <admin type="GUID">{00CB09AA-FFC2-4008-833A-BBA336AEC164}</admin>
        <transacGrp>
          <transac type="transactionType">origination</transac>
          <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
          <date>2024-02-15T09:57:50Z</date>
        </transacGrp>
        <transacGrp>
          <transac type="transactionType">modification</transac>
          <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
          <date>2024-02-15T10:09:10Z</date>
        </transacGrp>

        <langSet xml:lang="fr-ch">
          <ntig id="tid-8">
            <termGrp>
              <term>TARMED</term>
              <termNote type='termType'>fullForm</termNote>
              <termNote type='usageNote'>DOM: assurance-maladie; USG: privilégié; variante
                &quot;TarMed&quot; à éviter; EXP: tarif uniforme fixé par convention entre les
                partenaires tarifaires (ou fixé d’office par le Conseil fédéral) et appliqué par les
                hôpitaux et par les cabinets médicaux dans l&apos;ensemble de la Suisse</termNote>
              <termNote type='usageNoteSource'>d&apos;après LF Assurance-maladie, art. 46 (RS
                832.10, état 2018-01) et OFSP, Thèmes &gt; Assurances &gt; Assurance-maladie &gt;
                Prestations et tarifs &gt; Prestations médicales &gt; Système tarifaire TARMED
                (\h!https://www.bag.admin.ch/bag/fr/home/themen/versicherungen/krankenversicherung/krankenversicherung-leistungen-tarife/Aerztliche-Leistungen-in-der-Krankenversicherung/Tarifsystem-Tarmed.html!Internet,
                2017-10-04\s)</termNote>
              <termNote type='GUID'>{EE5EDA6E-C138-4006-A578-A945A1054C50}</termNote>
            </termGrp>
            <transacGrp>
              <transac type="transactionType">origination</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-15T10:01:42Z</date>
            </transacGrp>
            <transacGrp>
              <transac type="transactionType">modification</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-15T10:01:42Z</date>
            </transacGrp>
            <descripGrp>
              <descrip type="context">Pour la facturation à leurs patients, les médecins appliquent
                un tarif uniforme: le TARMED. Avec plus de 4600 positions, il comprend la
                quasi-totalité des prestations médicales et paramédicales fournies au cabinet
                médical et dans le domaine hospitalier ambulatoire.</descrip>
              <descripNote type="contextType">FMH &gt; Tarifs ambulatoires &gt; TARMED Tarif
                (\h!https://www.fmh.ch/404.html!Internet, 2016-09-06\s)</descripNote>
            </descripGrp>
            <admin type='entrySource'>O Fixation et adaptation de structures tarifaires dans
              l’assurance-maladie, art. 2 al. 1 (RS 832.102.5, état 2018-01)</admin>
          </ntig>

          <ntig id="tid-9">
            <termGrp>
              <term>structure tarifaire pour les prestations médicales</term>
              <termNote type='termType'>synonym</termNote>
              <termNote type='GUID'>{857CFD7A-8D55-4E23-B84F-E0B257161917}</termNote>
            </termGrp>
            <transacGrp>
              <transac type="transactionType">origination</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-15T10:01:42Z</date>
            </transacGrp>
            <transacGrp>
              <transac type="transactionType">modification</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-15T10:01:42Z</date>
            </transacGrp>
            <admin type='entrySource'>O Fixation et adaptation de structures tarifaires dans
              l’assurance-maladie, art. 2 al. 1 (RS 832.102.5, état 2018-01)</admin>
          </ntig>

          <ntig id="tid-12">
            <termGrp>
              <term>grille tarifaire TARMED</term>
              <termNote type='termType'>negative term</termNote>
              <termNote type='usageNote'>USG: à éviter</termNote>
              <termNote type='GUID'>{AE7AD159-AC11-4717-BE75-79C872808038}</termNote>
            </termGrp>
            <transacGrp>
              <transac type="transactionType">origination</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-15T10:07:59Z</date>
            </transacGrp>
            <transacGrp>
              <transac type="transactionType">modification</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-15T10:07:59Z</date>
            </transacGrp>
            <admin type='entrySource'>d&apos;après Po. Lohr (17.3540), Pour des soins sans
              discrimination, 2017-06-15
              (\h!https://www.parlament.ch/fr/ratsbetrieb/suche-curia-vista/geschaeft?AffairId=20173540!Internet,
              2017-10-04\s)</admin>
          </ntig>

          <ntig id="tid-10">
            <termGrp>
              <term>tarif médical et catalogue des prestations hospitalières</term>
              <termNote type='termType'>negative term</termNote>
              <termNote type='usageNote'>USG: à éviter</termNote>
              <termNote type='GUID'>{51EDCCC9-C1D4-4044-8DBE-C3F27ED5C4BB}</termNote>
            </termGrp>
            <transacGrp>
              <transac type="transactionType">origination</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-15T10:01:42Z</date>
            </transacGrp>
            <transacGrp>
              <transac type="transactionType">modification</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-15T10:01:42Z</date>
            </transacGrp>
            <admin type='entrySource'>FMH, Convention-cadre TARMED, art. 1 al. 1, 2005-06-05
              (\h!https://www.fmh.ch/files/pdf9/convention-cadre.pdf!Internet, 2016-03-31\s)</admin>
          </ntig>

          <ntig id="tid-11">
            <termGrp>
              <term>Tarmed</term>
              <termNote type='termType'>negative term</termNote>
              <termNote type='usageNote'>USG: à éviter, même si courant</termNote>
              <termNote type='GUID'>{3D6347D9-3832-4C8D-A316-B87923E9B861}</termNote>
            </termGrp>
            <transacGrp>
              <transac type="transactionType">origination</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-15T10:06:32Z</date>
            </transacGrp>
            <transacGrp>
              <transac type="transactionType">modification</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-15T10:06:32Z</date>
            </transacGrp>
            <admin type='entrySource'>ATUPRI, Comprendre enfin sa facture de médecin, 2017-01-11
              (\h!https://www.atupri.ch/fr/blog/perspectives/tarmed!Internet, 2017-10-04\s)</admin>
          </ntig>

        </langSet>

        <langSet xml:lang="de-ch">
          <ntig id="tid-5">
            <termGrp>
              <term>TARMED</term>
              <termNote type='termType'>fullForm</termNote>
              <termNote type='usageNote'>DOM: Krankenversicherung; USG: bevorzugt; EXP:
                &quot;TARMED&quot; ist das Initialwort (Akronym) des französischen Namens
                &quot;tarif médical&quot;; verträglich vereinbarter oder von Amtes wegen durch den
                Bundesrat festgesetzter einheitlicher Tarif, der gesamtschweizerisch in Spitälern
                und Arztpraxen verwendet wird</termNote>
              <termNote type='usageNoteSource'>nach BG Krankenversicherung, Art. 46 (SR 832.10,
                Stand 2018-01) und BAG, Themen &gt; Versicherungen &gt; Krankenversicherung &gt;
                Leistungen und Tarife &gt; Ärztliche Leistungen &gt; Tarifsystem TARMED
                (\h!https://www.bag.admin.ch/bag/de/home/themen/versicherungen/krankenversicherung/krankenversicherung-leistungen-tarife/Aerztliche-Leistungen-in-der-Krankenversicherung/Tarifsystem-Tarmed.html!Internet,
                20147-10-04\s)</termNote>
              <termNote type='GUID'>{6C687625-6B22-435C-B99F-CFD71575801B}</termNote>
            </termGrp>
            <transacGrp>
              <transac type="transactionType">origination</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-15T09:57:50Z</date>
            </transacGrp>
            <transacGrp>
              <transac type="transactionType">modification</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-15T09:57:50Z</date>
            </transacGrp>
            <admin type='entrySource'>V Festlegung und Anpassung von Tarifstrukturen in der
              Krankenversicherung, Art. 2 Abs. 1 (SR 832.102.5, Stand 2018-01)</admin>
          </ntig>

          <ntig id="tid-6">
            <termGrp>
              <term>Tarifstruktur für ärztliche Leistungen</term>
              <termNote type='termType'>synonym</termNote>
              <termNote type='GUID'>{4999DF46-B582-4139-A703-0ED16D0FB004}</termNote>
            </termGrp>
            <transacGrp>
              <transac type="transactionType">origination</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-15T09:57:50Z</date>
            </transacGrp>
            <transacGrp>
              <transac type="transactionType">modification</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-15T09:57:50Z</date>
            </transacGrp>
            <admin type='entrySource'>V Festlegung und Anpassung von Tarifstrukturen in der
              Krankenversicherung, Art. 2 Abs. 1 (SR 832.102.5, Stand 2018-01)</admin>
          </ntig>

          <ntig id="tid-7">
            <termGrp>
              <term>Arzttarif und Spitalleistungskatalog</term>
              <termNote type='termType'>negative term</termNote>
              <termNote type='usageNote'>USG: zu vermeiden</termNote>
              <termNote type='GUID'>{5E04ED28-3D17-44D1-AFE5-726AEEE273F4}</termNote>
            </termGrp>
            <transacGrp>
              <transac type="transactionType">origination</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-15T09:57:50Z</date>
            </transacGrp>
            <transacGrp>
              <transac type="transactionType">modification</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-15T09:57:50Z</date>
            </transacGrp>
            <admin type='entrySource'>FMH, Rahmenvertrag TARMED, Art. 1 Abs. 1, 2002-06-05
              (\h!https://www.fmh.ch/files/pdf5/rahmenvertrag_d.pdf!Internet, 2016-03-31\s)</admin>
          </ntig>

        </langSet>
      </termEntry>

      <termEntry id='eid-3'>
        <admin type="GUID">{AA44B3EB-07D6-47CA-A9E4-D44C2CB5AAF9}</admin>
        <transacGrp>
          <transac type="transactionType">origination</transac>
          <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
          <date>2024-02-19T07:14:49Z</date>
        </transacGrp>
        <transacGrp>
          <transac type="transactionType">modification</transac>
          <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
          <date>2024-02-19T09:14:20Z</date>
        </transacGrp>

        <langSet xml:lang="fr-ch">
          <ntig id="tid-14">
            <termGrp>
              <term>îlotage</term>
              <termNote type='termType'>fullForm</termNote>
              <termNote type='usageNote'>EXP: une ou plusieurs centrales de production alimentent
                les clients raccordés en assurant le réglage de la tension et de la fréquence; cette
                situation n&apos;est pas un mode de fonctionnement usuel des réseaux, mais peut se
                produire en régime perturbé</termNote>
              <termNote type='usageNoteSource'>Canton FR, Rupture d’approvisionnement électrique
                &gt; Dangers techniques: Electricité
                (\h!https://www.fr.ch/dsjs/sscm/dangers-techniques/rupture-dapprovisionnement-electrique!Internet,
                2022-09-14\s)</termNote>
              <termNote type='GUID'>{7C8107BB-D92A-4921-9FB5-B5B70673991B}</termNote>
            </termGrp>
            <transacGrp>
              <transac type="transactionType">origination</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-19T09:07:49Z</date>
            </transacGrp>
            <transacGrp>
              <transac type="transactionType">modification</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-19T09:07:49Z</date>
            </transacGrp>
            <admin type='entrySource'>Canton FR, Rupture d’approvisionnement électrique &gt; Dangers
              techniques: Electricité
              (\h!https://www.fr.ch/dsjs/sscm/dangers-techniques/rupture-dapprovisionnement-electrique!Internet,
              2022-09-14\s)</admin>
            <descripGrp>
              <descrip type='definition'>Régime d&apos;exploitation d&apos;une partie de réseau
                électrique (îlot) fonctionnant de manière autonome et sans interconnexion avec le
                réseau principal.</descrip>
              <descripNote type='definitionType'>Canton FR, Rupture d’approvisionnement électrique
                &gt; Dangers techniques: Electricité
                (\h!https://www.fr.ch/dsjs/sscm/dangers-techniques/rupture-dapprovisionnement-electrique!Internet,
                2022-09-14\s)</descripNote>
            </descripGrp>
          </ntig>

          <ntig id="tid-16">
            <termGrp>
              <term>exploitation en îlot</term>
              <termNote type='termType'>synonym</termNote>
              <termNote type='GUID'>{EC513204-8E23-48BC-BA8A-C00C773C429B}</termNote>
            </termGrp>
            <transacGrp>
              <transac type="transactionType">origination</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-19T09:12:10Z</date>
            </transacGrp>
            <transacGrp>
              <transac type="transactionType">modification</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-19T09:12:10Z</date>
            </transacGrp>
            <admin type='entrySource'>ESTI, Directive ESTI n° 220 Exigences sur les installations de
              production d&apos;énergie, 2021-07-01, p. 5
              (\h!https://www.esti.admin.ch/inhalte/ESTI_220_0621_FR.pdf!Internet, 2023-04-28\s)</admin>
          </ntig>

          <ntig id="tid-15">
            <termGrp>
              <term>fonctionnement en îlot</term>
              <termNote type='termType'>synonym</termNote>
              <termNote type='GUID'>{E0908E71-6E9E-4F3A-AF86-05F40B6B45BF}</termNote>
            </termGrp>
            <transacGrp>
              <transac type="transactionType">origination</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-19T09:07:49Z</date>
            </transacGrp>
            <transacGrp>
              <transac type="transactionType">modification</transac>
              <transacNote type="responsibility">Messina Chiara BK (bk)</transacNote>
              <date>2024-02-19T09:07:49Z</date>
            </transacGrp>
            <admin type='entrySource'>ESTI, Directive ESTI n° 220 Exigences sur les installations de
              production d&apos;énergie, 2021-07-01, p. 25
              (\h!https://www.esti.admin.ch/inhalte/ESTI_220_0621_FR.pdf!Internet, 2023-04-28\s)</admin>
          </ntig>

        </langSet>

        <langSet xml:lang="de-ch">
          <descripGrp>
            <descrip type='definition'>Definition auf Sprachebene</descrip>
            <descripNote type='definitionType'>mec</descripNote>
          </descripGrp>
          <ntig id="tid-13">
            <termGrp>
              <term>Inselbetrieb 2 DEF</term>
              <termNote type='termType'>fullForm</termNote>
              <termNote type='usageNote'>EXP: ein oder mehrere Kraftwerke versorgen die
                angeschlossenen Kunden und garantieren so die Regelung der Netzspannung und der
                Netzfrequenz; diese Situation entspricht nicht der regulären Funktionsweise eines
                Netzes, kann aber bei Störungen vorkommen</termNote>
              <termNote type='usageNoteSource'>nach Kanton FR, Stromversorgungsunterbruch &gt;
                Technische Gefahren: Strom
                (\h!https://www.fr.ch/de/sjsd/azsm/technische-gefahren/stromversorgungsunterbruch!Internet,
