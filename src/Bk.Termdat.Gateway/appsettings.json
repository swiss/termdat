{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Management": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Bk.Utils.Logging.SerilogFormatter, Bk.Utils"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "OpenIdConnect": {
    "ResponseType": "code",
    "CallbackPath": "/auth/signin-oidc",
    "SignedOutCallbackPath": "/auth/signout-callback-oidc",
    "SaveTokens": true,
    "Scope": "openid",
    "RequireHttpsMetadata": true,
    "TokenEndpointPath": "/protocol/openid-connect/token"
  },
  "Cookie": {
    "Name": "Bk.Termdat.Auth",
    "HttpOnly": true,
    "SecurePolicy": "SameAsRequest",
    "SameSite": "Lax",
    "ExpireTimeSpanHours": 8,
    "SlidingExpiration": true
  },
  "Gateway": {
    "UserEndpoint": "/auth/user",
    "LoginEndpoint": "/auth/login",
    "LogoutEndpoint": "/auth/logout"
  }
}
