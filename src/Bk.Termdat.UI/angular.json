{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "bk-termdat-ui": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "td",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "allowedCommonJsDependencies": [
              "ajv",
              "ajv-formats",
              "lodash"
            ],
            "outputPath": "dist/bk-termdat-ui",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": [
                "."
              ]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "node_modules/@oblique/oblique/assets",
                "output": "assets"
              },
              "src/assets"
            ],
            "styles": [
              "node_modules/@oblique/oblique/styles/css/oblique-core.css",
              "node_modules/@oblique/oblique/styles/css/oblique-icons.css",
              "node_modules/@oblique/oblique/styles/css/oblique-alert.css",
              "src/styles/styles.scss",
              "src/styles/grid.scss",
              "node_modules/froala-editor/css/froala_editor.pkgd.min.css"
            ],
            "scripts": [
              "node_modules/@oblique/oblique/ob-features.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "bundle",
                  "name": "main",
                  "maximumWarning": "1700kb",
                  "maximumError": "2000kb"
                },
                {
                  "type": "initial",
                  "maximumWarning": "3000kb",
                  "maximumError": "4000kb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kb",
                  "maximumError": "16kb"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "styles": {
                  "inlineCritical": false
                }
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "headers": {
              "Content-Security-Policy": "default-src 'none'; script-src 'self' https://analytics.bit.admin.ch http://localhost:8045/ 'nonce-MatomoTagManager'; form-action 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://analytics.bit.admin.ch http://localhost:9082/ http://localhost:8045/; frame-src 'self' http://localhost:9082/; frame-ancestors 'self' http://localhost:9082/;"
            },
            "port": 4445,
            "proxyConfig": "proxy.config.json",
            "buildTarget": "bk-termdat-ui:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "bk-termdat-ui:build:production"
            },
            "development": {
              "buildTarget": "bk-termdat-ui:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-builders/jest:run",
          "options": {
            "config": "tests/jest.config.js",
            "tsConfig": "tsconfig.spec.json",
            "watch": false,
            "zoneless": false
          },
          "configurations": {
            "production": {
              "watch": false,
              "verbose": false
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "td",
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "prefix": "td",
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "cli": {
    "schematicCollections": [
      "@angular-eslint/schematics"
    ],
    "analytics": false
  }
}
