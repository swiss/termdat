{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Management": "Warning",
        "Bk.Termdat.Business.Services.SearchIndexService": "Information",
        "Bk.Termdat.Search.Api.BackgroundServices": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Swiss.FCh.Utils.Logging.SerilogFormatter, Swiss.FCh.Utils"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Authentication": {
    "IsHttps": true
  },
  "Search": {
    "ContinueOnError": true,
    "RefreshDelay": 5.0,
    "PreferredEntrySequenceId": "1",
    "AchOfficeId": 1,
    "QueryBoostPriorityMultiplier": 1,
    "QueryBoostHighestPriority": 15.0,
    "QueryBoostVeryHighPriority": 7.5,
    "QueryBoostHighPriority": 5.0,
    "QueryBoostMidPriority": 4.0,
    "QueryBoostLowPriority": 3.0,
    "QueryBoostVeryLowPriority": 2.0,
    "QueryBoostLowestPriority": 1.5,
    "RecommendationMinLength": 4,
    "RecommendationResultSize": 10,
    "RecreateIndexOnStartUp": true,
    "IndexPageSize": 5000
  },
  "Swagger": {
    "Enabled": false
  }
}
