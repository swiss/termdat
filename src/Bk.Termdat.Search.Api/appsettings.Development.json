{
  "pgsql": {
    "hostname": "localhost",
    "port": "5434",
    "database_name": "termdat"
  },
  "rabbitmq": {
    "clusterUrl": "localhost",
    "clusterPort": "5672"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Management": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Authentication": {
    "Url": "http://localhost:9082/realms/bk-termdat",
    "ClientId": "bk-termdat",
    "IsHttps": false
  },
  "Authorization": {
    "Allow": "ALLOW",
    "Writer": "Writer",
    "SuperUser": "SuperUser",
    "SuperReader": "SuperReader",
    "Admin": "Admin"
  },
  "Search": {
    "ContinueOnError": false,
    "IndexPageSize": 5000
  },
  "Swagger": {
    "Enabled": true
  }
}
